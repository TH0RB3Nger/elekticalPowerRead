#pragma once

#include <Arduino.h>
#include <float.h>
#include "Logging.h"

/**
 * @brief Zentrale Projektkonfiguration. Kopiere diese Datei nach Config.h.
 *
 * Die lokale Config.h wird absichtlich nicht versioniert, da sie Zugangsdaten
 * enthalten kann. Aendere Werte in den passenden Unterbereichen.
 */
namespace Config {

/// Zugangsdaten fuer das lokale WLAN.
namespace Wifi {
static char ssid[] = "REPLACE_WITH_WIFI_NAME";
static char password[] = "REPLACE_WITH_WIFI_PASSWORD";
}

/// Verbindungseinstellungen fuer MariaDB oder MySQL.
namespace Database {
static char host[] = "192.168.1.100";
static constexpr uint16_t port = 3306;
static char name[] = "energy_monitor";
static char user[] = "esp32_meter";
static char password[] = "REPLACE_WITH_A_SECRET";
}

/// Hardwarezuordnung der vier Impulszaehler zu ESP32-GPIOs.
namespace Counters {
constexpr uint8_t pin1 = 4;
constexpr uint8_t pin2 = 5;
constexpr uint8_t pin3 = 6;
constexpr uint8_t pin4 = 7;

static_assert(
    pin1 != pin2 && pin1 != pin3 && pin1 != pin4
        && pin2 != pin3 && pin2 != pin4 && pin3 != pin4,
    "Jeder Zaehler muss einen eigenen GPIO verwenden"
);
}

/// Impulserfassung, Pufferschutz und Upload-Zeitplan.
namespace Runtime {
/// Zaehleraufloesung in Impulsen pro Kilowattstunde.
/// Beispiel: 1000 Impulse/kWh entsprechen 0,001 kWh je Impuls.
constexpr double resolutionPulsesPerKWh = 1000.0;

/// true: Impuls aktiv bei HIGH; false: Impuls aktiv bei LOW (typisch S0).
constexpr bool pulseActiveHigh = true;

/// Minimale Dauer des aktiven Pegels, damit ein S0-Impuls gezaehlt wird.
constexpr unsigned long minimumPulseDurationMs = 30;

/// Mindestabstand zwischen zwei gezaehlten Impulsen zur Stoerunterdrueckung.
constexpr unsigned long minimumPulseIntervalMs = 50;

static_assert(
    resolutionPulsesPerKWh > 0.0 && resolutionPulsesPerKWh <= DBL_MAX,
    "Die Zaehleraufloesung muss positiv und endlich sein"
);

/// Uploadtakt in Minuten; muss ein positiver Teiler von 60 sein.
constexpr uint8_t uploadEveryMinutes = 15;

/// Bei diesem freien NVS-Anteil oder weniger wird sofort synchronisiert.
constexpr uint8_t minimumFreeNvsPercent = 10;

/// Wartezeit zwischen fehlgeschlagenen Datenbank-Uploadversuchen.
constexpr unsigned long uploadRetryMs = 30000UL;

/// Wartezeit zwischen Flash-Kapazitaetsabfragen.
constexpr unsigned long flashMonitorIntervalMs = 60000UL;

/// Mindeststufe der seriellen Protokollausgabe.
constexpr LogLevel minimumLogLevel = LOG_DEBUG_PLUS;

/// Timeout fuer den initialen WLAN-Verbindungsaufbau.
constexpr unsigned long wifiConnectionTimeoutMs = 10000UL;

/// Abstand zwischen automatischen WLAN-Reconnect-Versuchen.
constexpr unsigned long wifiReconnectIntervalMs = 5000UL;

/// Abstand zwischen RSSI-Ausgaben im DEBUG+-Modus.
constexpr unsigned long wifiSignalLogIntervalMs = 10000UL;

/// Baudrate der seriellen Debug-Ausgabe.
constexpr unsigned long serialBaudRate = 115200UL;

/// Wartezeit pro Hauptschleifendurchlauf.
constexpr unsigned long mainLoopDelayMs = 1000UL;

static_assert(
    uploadEveryMinutes > 0 && 60 % uploadEveryMinutes == 0,
    "uploadEveryMinutes muss ein positiver Teiler von 60 sein"
);

static_assert(
    minimumPulseDurationMs <= 4294967UL
        && minimumPulseIntervalMs <= 4294967UL,
    "S0-Zeitparameter muessen in den micros()-Messbereich passen"
);
}

/// Zeitzone und Server fuer die NTP-Synchronisation.
namespace Time {
/// POSIX-Zeitzone fuer Mitteleuropa mit automatischer Sommerzeit.
constexpr char timeZone[] = "CET-1CEST,M3.5.0/2,M10.5.0/3";

/// Primaerer NTP-Zeitserver.
constexpr char ntpServerPrimary[] = "pool.ntp.org";

/// Sekundaerer NTP-Zeitserver als Ausweichquelle.
constexpr char ntpServerSecondary[] = "time.nist.gov";
}

}
